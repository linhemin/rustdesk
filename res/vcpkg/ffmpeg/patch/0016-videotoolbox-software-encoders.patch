 #define OFFSET(x) offsetof(VTEncContext, x)
+#if CONFIG_H264_VIDEOTOOLBOX_SW_ENCODER || CONFIG_HEVC_VIDEOTOOLBOX_SW_ENCODER
+static av_cold int vtenc_init_sw(AVCodecContext *avctx)
+{
+    VTEncContext *vtctx = avctx->priv_data;
+    vtctx->require_sw = 1;
+    /* Apple's low-latency H.264 mode requests a hardware encoder. */
+    if (avctx->codec_id == AV_CODEC_ID_H264)
+        avctx->flags &= ~AV_CODEC_FLAG_LOW_DELAY;
+    return vtenc_init(avctx);
+}
+#endif
